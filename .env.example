# Webhook base url
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# App base url
APP_BASE_URL = http://localhost:3000

# Auth (JWT access + opaque refresh tokens in DB)
# JWT_SECRET=
# Short-lived access token (defaults to JWT_EXPIRES_IN if unset)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_EXPIRES_IN=7d
# Refresh token lifetime in days (default 30)
# REFRESH_TOKEN_EXPIRES_DAYS=30

# OpenAI API Configuration
OPENAI_API_KEY=

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Messaging — Meta Cloud API (default)
WHATSAPP_PROVIDER=meta
# From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# Required for auto token refresh (App settings → Basic)
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
# APP_ID + APP_SECRET are required — without them tokens are NOT auto-exchanged (they expire in hours).
# DB stores the long-lived token after exchange. Check: GET /whatsapp/admin/meta-token/expiry
# After pasting a new token: restart app OR POST /whatsapp/admin/meta-token/sync-env-token
# WHATSAPP_META_API_VERSION=v25.0
# WHATSAPP_META_DEFAULT_LANGUAGE=en
# Webhook (Meta App → WhatsApp → Configuration)
# Callback URL: {WEBHOOK_BASE_URL}/webhook/whatsapp
WHATSAPP_META_VERIFY_TOKEN=
# App Secret from Meta App Dashboard → App settings → Basic (NOT the access token)
WHATSAPP_META_APP_SECRET=
# Local/ngrok testing only — skip signature check (never enable in production)
# WHATSAPP_META_SKIP_SIGNATURE=true
# Optional display number (E.164)
# WHATSAPP_FROM_NUMBER=
# Bulk campaigns — BullMQ outbound queue (required for multi-tenant campaigns)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
WHATSAPP_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret
WHATSAPP_MAX_MESSAGES_PER_SECOND=5
WHATSAPP_MAX_MESSAGES_PER_MINUTE=80
WHATSAPP_MAX_RETRIES=5
WHATSAPP_RETRY_BACKOFF_MS=5000
WHATSAPP_FREEFORM_WINDOW_HOURS=24
# Utility template for business-initiated / outside-24h single sends (body → {{1}})
WHATSAPP_DEFAULT_OUTBOUND_TEMPLATE_NAME=
WHATSAPP_DEFAULT_OUTBOUND_TEMPLATE_LANGUAGE=en
# Local dev only — use global env Meta creds when company config missing
# WHATSAPP_ALLOW_GLOBAL_META_FALLBACK=true
# WHATSAPP_BULK_MAX_RECIPIENTS=5000
# WHATSAPP_BULK_DELAY_MS=800
# WHATSAPP_QUEUE_BATCH_SIZE=20
# WHATSAPP_QUEUE_POLL_MS=2000

# Run migrations:
# app/src/migrations/create-whatsapp-chat-tables.sql
# app/src/migrations/add-whatsapp-meta-token.sql
# app/src/migrations/multi-tenant-whatsapp.sql
# app/src/migrations/add-whatsapp-template-meta-id.sql
# Template workflow: see app/src/whatsapp/WHATSAPP_TEMPLATES.md

# Twilio WhatsApp (only if WHATSAPP_PROVIDER=twilio)
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_FROM_NUMBER=+14155238886
# Status webhook: POST {WEBHOOK_BASE_URL}/webhook/whatsapp/twilio/status

# LinkedIn Company Page -> Blogs integration
# From LinkedIn Developer Portal -> your app -> Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a "Authorized redirect URL" configured on the app
LINKEDIN_REDIRECT_URI={WEBHOOK_BASE_URL}/linkedin/callback
# Requested OAuth scopes (space/comma separated). Requires LinkedIn's "Community Management API" product approval.
# r_organization_social = read the page's posts. r_organization_admin = auto-discover the
# organization id via /rest/organizationAcls, so nobody has to type in the numeric company id.
LINKEDIN_SCOPES=r_organization_social r_organization_admin
# LinkedIn-Version header for the versioned REST (Posts) API, format YYYYMM
# LINKEDIN_API_VERSION=202401
# AES-256-GCM key used to encrypt stored LinkedIn tokens at rest — set a long random secret
LINKEDIN_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Cron expression for the LinkedIn -> Blogs sync job (default: every 30 minutes)
# LINKEDIN_SYNC_CRON=*/30 * * * *
# Posts fetched per page / max pages walked per organization per run
# LINKEDIN_POSTS_PAGE_SIZE=20
# LINKEDIN_MAX_PAGES_PER_SYNC=5
# Hashtag (no '#') that marks a synced post as publishable; anything else is saved as a draft
# LINKEDIN_PUBLISH_HASHTAG=hexa-blog
# Where the OAuth callback redirects the admin's browser after connecting (falls back to APP_BASE_URL)
# FRONTEND_BASE_URL=http://localhost:3001
# Run migration: app/src/migrations/create-linkedin-and-blogs-tables.sql

# Mozo App Store bridge (/mozo/*) — folded in from the standalone mozo-widget/backend reference
# CLIENT_ID/SECRET are not handed out by Mozo — you generate them by registering your own app
# and rotating credentials (POST /v4/app-store/app/:app_id/credential/rotate). See
# app/src/mozo/README.md § Getting real credentials for the full onboarding sequence.
MOZO_CLIENT_ID=
MOZO_CLIENT_SECRET=
# Self-chosen (openssl rand -hex 16+), registered via PUT /v4/app-store/app/:app_id/webhook — not issued by Mozo.
MOZO_WEBHOOK_SECRET=
# Base URL of the Mozo environment you're targeting (staging or production), e.g. https://api.mozo.example.com
MOZO_API_URL=
# Comma-separated origins allowed to call /mozo/* from a browser (the widget inside Mozo's iframe).
# Local dev: the widget's dev server origin. Production: Mozo's real hosting origin.
MOZO_ALLOWED_ORIGINS=http://localhost:5175
# Plain infra secret shared with the Mozo bridge for POST /auth/embedded-session
# (header: X-Mozo-Bridge-Secret). NOT an API key — never exposed in any UI, never
# rotatable by end users. Generate with: openssl rand -hex 32
MOZO_BRIDGE_SHARED_SECRET=
# Single-tenant: the one company every embedded session / /mozo/hexaai/activity call resolves to.
MOZO_SINGLE_TENANT_COMPANY_ID=
# Single-tenant: the one Mozo venue_id (entity_id) used for GET /mozo/menu and GET /mozo/orders.
MOZO_SINGLE_TENANT_VENUE_ID=
# Run migration: app/src/migrations/create-mozo-venue-links-table.sql

# Mozo's real direct venue/POS API (MozoApiService: menu/orders/venue) — a separate product
# from the App Store OAuth vars above. Auth is a static X-API-Key header, issued directly by
# Mozo per environment (see their admin panel), not generated via app registration.
# Base URL of the Mozo environment you're targeting, e.g. https://testapiv2.themozo.net
MOZO_DIRECT_API_URL=
MOZO_DEVELOPER_AUTH_KEY=

# Telnyx Configuration (outbound fallback + inbound on TELNYX_PHONE_NUMBER)
TELNYX_API_KEY=
# Call Control Application / Connection ID (Voice API Application)
TELNYX_CONNECTION_ID=
# Default/generic Telnyx DID — used for every company except TELNYX_NL_COMPANY_ID below.
TELNYX_PHONE_NUMBER=
# Netherlands Telnyx DID — used only for the company set in TELNYX_NL_COMPANY_ID. Optional: leave
# both this and TELNYX_NL_COMPANY_ID unset to always use TELNYX_PHONE_NUMBER.
TELNYX_PHONE_NUMBER_NL=
# Company UUID that must always dial out from TELNYX_PHONE_NUMBER_NL.
TELNYX_NL_COMPANY_ID=
# Assign the number to the Call Control app; set webhook URL to:
# POST {WEBHOOK_BASE_URL}/webhook/telnyx/events

# Outbound dial provider selection: auto (try Twilio, fall back to Telnyx — default),
# telnyx (skip Twilio entirely), or twilio (never fall back to Telnyx).
OUTBOUND_TELEPHONY_PROVIDER=auto

# Voice: cloud = ElevenLabs TTS + STT (default for staging/production). local = Chatterbox + Whisper (dev).
VOICE_MODE=cloud

# ElevenLabs multilingual (default on): auto-detect STT language + LLM interprets user speech before flow matching.
# ELEVENLABS_STT_MULTILINGUAL=false
# Force multilingual TTS model for every call (optional; default routes by language list):
# ELEVENLABS_TTS_MULTILINGUAL_ALL=true
# ELEVENLABS_TTS_MULTILINGUAL_LANGS=ur,ar,hi,es,fr,de,no
# eleven_multilingual_v2 works on stream-input for most plans; eleven_v3 may return 403
# ELEVENLABS_TTS_MODEL_MULTILINGUAL=eleven_multilingual_v2
# ELEVENLABS_TTS_MODEL_FALLBACKS=eleven_multilingual_v2,eleven_turbo_v2_5
# Set agent/call metadata language=ur for Urdu (STT hint + TTS); Scribe supports language_code=ur

# Local voice (when VOICE_MODE=local)
# Gradio UI on :7860 uses /gradio_api/call — apiType defaults to gradio when URL contains :7860.
CHATTERBOX_BASE_URL=http://127.0.0.1:7860
# openai = POST /v1/audio/speech. gradio = @gradio/client (default when URL uses :7860).
# CHATTERBOX_API_TYPE=gradio
# Gradio "View API" endpoint name (Chatterbox default: wrap_generate → /wrap_generate).
# CHATTERBOX_GRADIO_API_NAME=wrap_generate
# Language dropdown label (e.g. English). Leave unset to map from agent language (en → English).
# CHATTERBOX_GRADIO_LANG_NAME=English
# Local reference audio for voice cloning (required for /wrap_generate).
CHATTERBOX_DEFAULT_VOICE_PATH=./voice-sample.mp3
# Set true if the Gradio fn takes [text, reference_audio].
# CHATTERBOX_GRADIO_INCLUDE_VOICE=false
# If Chatterbox is not running, fall back to ElevenLabs TTS (needs ELEVENLABS_API_KEY). Set false to disable.
CHATTERBOX_FALLBACK_TO_ELEVENLABS=true
# Self-hosted Whisper only (when WHISPER_USE_OPENAI=false or no OPENAI_API_KEY)
WHISPER_SERVER_URL=http://localhost:8000
# Use OpenAI Whisper API with OPENAI_API_KEY (default true). Set false to require local server.
WHISPER_USE_OPENAI=true
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE_CODE=en
